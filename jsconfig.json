{
  "compilerOptions": {
    "checkJs": true, // Enables type checking for JavaScript files
    "module": "commonjs", // Jest uses CommonJS
    "moduleResolution": "bundler", // Use Node.js module resolution
    "paths": {
      "*": ["./*"], // Map all imports to project root
      "jest": ["./node_modules/jest"]
    }
  },
  "include": ["**/*.js"],
  "exclude": ["node_modules"]
}
