{
  "compilerOptions": {
    "checkJs": true, // Enables type checking for JavaScript files
    "module": "nodenext", // Jest uses CommonJS
    "moduleResolution": "nodenext", // Use Node.js module resolution
    "paths": {
      "*": ["./*"], // Map all imports to project root
      "jest": ["./node_modules/jest"]
    }
  },
  "include": ["src/**/*", "**/*.js"],
  "exclude": ["node_modules", "dist"]
}
